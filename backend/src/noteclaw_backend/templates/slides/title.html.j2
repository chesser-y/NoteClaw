<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<style>
  :root {
    --bg: #0f1115;
    --panel: #1a1d24;
    --accent: #626be6;
    --text: #f4f5f7;
    --muted: #8b8f99;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1280px; height: 720px; overflow: hidden; }
  body {
    background: linear-gradient(135deg, var(--bg) 0%, var(--panel) 100%);
    color: var(--text);
    font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 96px;
  }
  .accent-bar {
    width: 64px;
    height: 4px;
    background: var(--accent);
    margin-bottom: 32px;
  }
  h1 {
    font-size: {{ font_size | default(64) }}px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -1px;
    margin-bottom: 24px;
    max-width: 1000px;
  }
  .subtitle {
    font-size: 24px;
    color: var(--muted);
    font-weight: 400;
    max-width: 880px;
    line-height: 1.4;
  }
  .meta {
    position: absolute;
    bottom: 56px;
    left: 96px;
    font-size: 14px;
    color: var(--muted);
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .badge {
    position: absolute;
    top: 56px;
    right: 96px;
    padding: 6px 14px;
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: 999px;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
</style>
</head>
<body>
  <div class="badge">{{ deck_label | default("NoteClaw Deck") }}</div>
  <div class="accent-bar"></div>
  <h1>{{ title }}</h1>
  {% if subtitle %}<div class="subtitle">{{ subtitle }}</div>{% endif %}
  <div class="meta">{{ author | default("Generated by NoteClaw") }}</div>
</body>
</html>
