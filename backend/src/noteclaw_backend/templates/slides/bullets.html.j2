<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<style>
  :root {
    --bg: #0f1115;
    --panel: #1a1d24;
    --accent: #626be6;
    --text: #f4f5f7;
    --muted: #8b8f99;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1280px; height: 720px; overflow: hidden; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
    display: flex;
    flex-direction: column;
    padding: 64px 96px;
  }
  .header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 36px;
  }
  .num {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--accent);
    color: white;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
  }
  h2 {
    font-size: 38px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }
  .accent-line {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, var(--accent) 0%, transparent 100%);
    margin-bottom: 32px;
  }
  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    flex: 1;
  }
  li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    font-size: {{ body_size | default(22) }}px;
    line-height: 1.5;
  }
  li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    margin-top: 12px;
    flex-shrink: 0;
  }
  .bullet-text {
    flex: 1;
  }
  .bullet-text strong {
    color: var(--text);
    font-weight: 600;
  }
  .bullet-text .desc {
    color: var(--muted);
    font-size: 0.78em;
    margin-top: 2px;
    display: block;
  }
  .footer {
    margin-top: 24px;
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.5px;
  }
</style>
</head>
<body>
  <div class="header">
    <span class="num">{{ index | default(1) }}</span>
    <h2>{{ title }}</h2>
  </div>
  <div class="accent-line"></div>
  <ul>
    {% for b in bullets %}
      <li>
        <div class="bullet-text">
          {% if b.heading %}<strong>{{ b.heading }}</strong>{% if b.text %}: {{ b.text }}{% endif %}{% else %}{{ b }}{% endif %}
          {% if b.description %}<span class="desc">{{ b.description }}</span>{% endif %}
        </div>
      </li>
    {% endfor %}
  </ul>
  <div class="footer">{{ deck_label | default("NoteClaw") }}</div>
</body>
</html>
